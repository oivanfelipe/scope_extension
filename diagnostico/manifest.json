{
  "manifest_version": 3,
  "name": "Diagnóstico Rápido · V4",
  "short_name": "Diagnóstico",
  "version": "0.4.0",
  "description": "Checklist objetivo do site, do Instagram e dos anúncios do cliente para usar em reunião de venda, com resumo opcional por IA.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Diagnóstico Rápido · Analisar este site",
    "default_icon": { "16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png" }
  },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
